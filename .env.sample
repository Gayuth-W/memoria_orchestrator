# memoria orchestrator — local Ollama backend (no API key needed)

# Ollama (the LLM). Same server memoria uses for embeddings.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
EXTRACTION_MODEL=     # extraction/classification; defaults to OLLAMA_MODEL
OLLAMA_TIMEOUT=
MAX_TOKENS=
TEMPERATURE=

# memoria backend
MEMORIA_BASE_URL=
MEMORIA_API_KEY=choose-a-key-and-register-it-with-memoria

SEARCH_TOP_K=
PROFILE_STORE_PATH=   # "none" for in-memory only
